generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  COORDINATOR
  RESEARCHER
  TECHNICIAN
}

enum LabStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  IN_USE
  UNDER_MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ISSUED
  IN_USE
  RETURNED
  CLOSED
  CANCELLED
}

enum MaintenanceStatus {
  REPORTED
  DIAGNOSING
  REPAIRING
  TESTING
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum InnovationStage {
  IDEA
  PROTOTYPE
  TESTING
  VALIDATED
  TRANSFERRED
}

enum InnovationStatus {
  SUBMITTED
  UNDER_EVALUATION
  APPROVED
  REJECTED
  COMPLETED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  REQUEST
  MAINTENANCE
  ACTION_REQUIRED
  ASSIGNMENT
  STATUS_CHANGE
  DEADLINE
}

enum EventType {
  CONFERENCE
  SEMINAR
  WORKSHOP
  SYMPOSIUM
  RESEARCH_PRESENTATION
  EXHIBITION
  INNOVATION_SHOWCASE
  TRAINING
  WEBINAR
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  REGISTERED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ISSUE
  RETURN
  MAINTENANCE
  STATUS_CHANGE
  PROGRESS_UPDATE
  VERSION_UPLOAD
  DOWNLOAD
  ARCHIVE
  AUTHOR_UPDATE
  WITHDRAW
  SPENDING_UPDATE
  SUBMIT
  REQUEST_REVISION
  ASSIGN_REVIEWER
  OTHER
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  PRINCIPAL_INVESTIGATOR
  CO_INVESTIGATOR
  RESEARCHER
  RESEARCH_ASSISTANT
  TECHNICAL_MEMBER
}

enum DocumentType {
  PROPOSAL
  RESEARCH_PLAN
  PROGRESS_REPORT
  FINAL_REPORT
  TECHNICAL_REPORT
  DATASET
  PRESENTATION
  THESIS
  MANUSCRIPT
  PAPER
  OTHER
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  BOOK_CHAPTER
  THESIS
  TECHNICAL_REPORT
  WORKING_PAPER
  PATENT
  OTHER
}

enum PublicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  PUBLISHED
  REJECTED
}

enum FundingType {
  INTERNAL
  NATIONAL
  INTERNATIONAL
  INDUSTRY
  NGO
  UNIVERSITY
  OTHER
}

enum FundingOpportunityStatus {
  OPEN
  CLOSED
  UPCOMING
  CANCELLED
}

enum GrantApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum GrantStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum BudgetCategory {
  PERSONNEL
  EQUIPMENT
  MATERIALS
  TRAVEL
  TRAINING
  SOFTWARE
  LABORATORY
  PUBLICATION
  CONFERENCE
  ADMINISTRATION
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECORDED
  CANCELLED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  COMPLETED
}

enum ResearchReportType {
  PROGRESS
  INTERIM
  FINAL
  TECHNICAL
  FINANCIAL
  ANNUAL
}

enum ResearchReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUIRED
  REJECTED
  RESUBMITTED
  WITHDRAWN
}

enum EthicsApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EthicsReviewDecision {
  APPROVE
  REJECT
  REQUEST_REVISION
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  role         UserRole  @default(RESEARCHER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  researcher               Researcher?
  auditLogs                AuditLog[]
  notifications            Notification[]
  assignedMaintenance      MaintenanceRecord[]       @relation("AssignedTechnician")
  reportedMaintenance      MaintenanceRecord[]       @relation("ReportedByUser")
  createdActivities        ProjectActivity[]
  uploadedDocuments        ResearchDocument[]        @relation("UploadedDocuments")
  uploadedDocumentVersions ResearchDocumentVersion[]
  createdPublications      ResearchPublication[]     @relation("CreatedPublications")
  reviewedApplications     GrantApplication[]        @relation("ReviewedApplications")
  createdGrants            ResearchGrant[]           @relation("CreatedGrants")
  assignedEthicsReviews    EthicsReviewer[]          @relation("AssignedByUser")
  createdEvents            ResearchEvent[]           @relation("CreatedEvents")
  createdAllocations       BudgetAllocation[]        @relation("CreatedAllocations")
  approvedExpenses         ResearchExpense[]         @relation("ApprovedExpenses")
  createdMilestones        ResearchMilestone[]       @relation("CreatedMilestones")
  reviewedReports          ResearchReport[]          @relation("ReviewedReports")
  updatedSettings          SystemSetting[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Researcher {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  employeeOrStudentId String   @unique @map("employee_or_student_id")
  department          String
  academicPosition    String?  @map("academic_position")
  bio                 String?
  researchAreas       String?  @map("research_areas")
  expertise           String?
  profileImage        String?  @map("profile_image")
  orcid               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentRequests          EquipmentRequest[]
  equipmentAssignments       EquipmentAssignment[]
  innovations                Innovation[]
  reportedMaintenance        MaintenanceRecord[]   @relation("ReportedMaintenance")
  maintainedEquipment        MaintenanceRecord[]   @relation("MaintenanceResearcher")
  projectMemberships         ProjectMember[]
  publicationAuthors         PublicationAuthor[]
  grantApplications          GrantApplication[]
  principalGrants            ResearchGrant[]       @relation("PrincipalInvestigator")
  ethicsApplications         EthicsApplication[]   @relation("EthicsApplicant")
  reviewedEthicsApplications EthicsApplication[]   @relation("EthicsApplicationReviewer")
  ethicsReviews              EthicsReview[]        @relation("EthicsReviewReviewer")
  assignedEthicsReviews      EthicsReviewer[]      @relation("AssignedReviewer")
  eventParticipations        EventParticipation[]
  submittedExpenses          ResearchExpense[]     @relation("SubmittedExpenses")
  submittedReports           ResearchReport[]      @relation("SubmittedReports")

  @@index([employeeOrStudentId])
  @@index([department])
  @@map("researchers")
}

model Laboratory {
  id                  String    @id @default(uuid())
  name                String
  code                String    @unique
  location            String
  description         String?
  capacity            Int?
  responsiblePersonId String?   @map("responsible_person_id")
  status              LabStatus @default(ACTIVE)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  equipment Equipment[]

  @@index([code])
  @@index([status])
  @@map("laboratories")
}

model Equipment {
  id             String             @id @default(uuid())
  name           String
  assetId        String             @unique @map("asset_id")
  serialNumber   String?            @map("serial_number")
  category       String
  manufacturer   String?
  model          String?
  description    String?
  purchaseDate   DateTime?          @map("purchase_date")
  purchasePrice  Decimal?           @map("purchase_price") @db.Decimal(12, 2)
  laboratoryId   String             @map("laboratory_id")
  condition      EquipmentCondition @default(GOOD)
  status         EquipmentStatus    @default(AVAILABLE)
  warrantyExpiry DateTime?          @map("warranty_expiry")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  laboratory           Laboratory            @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  equipmentRequests    EquipmentRequest[]
  equipmentAssignments EquipmentAssignment[]
  maintenanceRecords   MaintenanceRecord[]

  @@index([assetId])
  @@index([serialNumber])
  @@index([status])
  @@index([laboratoryId])
  @@index([category])
  @@map("equipment")
}

model EquipmentRequest {
  id                 String          @id @default(uuid())
  requesterId        String          @map("requester_id")
  equipmentId        String          @map("equipment_id")
  researchProjectId  String?         @map("research_project_id")
  purpose            String
  startDate          DateTime        @map("start_date")
  expectedReturnDate DateTime        @map("expected_return_date")
  priority           RequestPriority @default(MEDIUM)
  status             RequestStatus   @default(SUBMITTED)
  reviewComment      String?         @map("review_comment")
  reviewedById       String?         @map("reviewed_by_id")
  reviewedAt         DateTime?       @map("reviewed_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  requester       Researcher           @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  equipment       Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  researchProject ResearchProject?     @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  assignment      EquipmentAssignment?

  @@index([status])
  @@index([requesterId])
  @@index([equipmentId])
  @@index([researchProjectId])
  @@map("equipment_requests")
}

model EquipmentAssignment {
  id                String    @id @default(uuid())
  equipmentId       String    @map("equipment_id")
  researcherId      String    @map("researcher_id")
  researchProjectId String?   @map("research_project_id")
  requestId         String?   @unique @map("request_id")
  issuedById        String    @map("issued_by_id")
  issuedAt          DateTime  @map("issued_at")
  expectedReturnAt  DateTime  @map("expected_return_at")
  returnedAt        DateTime? @map("returned_at")
  receivedById      String?   @map("received_by_id")
  conditionAtIssue  String?   @map("condition_at_issue")
  conditionAtReturn String?   @map("condition_at_return")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  equipment       Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  researcher      Researcher        @relation(fields: [researcherId], references: [id], onDelete: Restrict)
  researchProject ResearchProject?  @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  request         EquipmentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([researcherId])
  @@index([researchProjectId])
  @@map("equipment_assignments")
}

model MaintenanceRecord {
  id                      String            @id @default(uuid())
  equipmentId             String            @map("equipment_id")
  reportedById            String            @map("reported_by_id")
  assignedTechnicianId    String?           @map("assigned_technician_id")
  reportedByUserId        String?           @map("reported_by_user_id")
  maintenanceResearcherId String?           @map("maintenance_researcher_id")
  problemDescription      String            @map("problem_description")
  priority                RequestPriority   @default(MEDIUM)
  status                  MaintenanceStatus @default(REPORTED)
  diagnosis               String?
  actionTaken             String?           @map("action_taken")
  reportedAt              DateTime          @default(now()) @map("reported_at")
  startedAt               DateTime?         @map("started_at")
  completedAt             DateTime?         @map("completed_at")
  cost                    Decimal?          @db.Decimal(12, 2)
  notes                   String?
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  equipment             Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedBy            Researcher  @relation("ReportedMaintenance", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTechnician    User?       @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  reportedByUser        User?       @relation("ReportedByUser", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  maintenanceResearcher Researcher? @relation("MaintenanceResearcher", fields: [maintenanceResearcherId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([status])
  @@index([assignedTechnicianId])
  @@index([reportedByUserId])
  @@index([maintenanceResearcherId])
  @@map("maintenance_records")
}

model ResearchProject {
  id            String        @id @default(uuid())
  projectCode   String        @unique @map("project_code")
  title         String
  description   String?
  projectStatus ProjectStatus @default(ACTIVE) @map("project_status")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  equipmentRequests    EquipmentRequest[]
  equipmentAssignments EquipmentAssignment[]
  innovations          Innovation[]
  projectMembers       ProjectMember[]
  projectActivities    ProjectActivity[]
  documents            ResearchDocument[]
  publications         ResearchPublication[]
  grantApplications    GrantApplication[]
  researchGrants       ResearchGrant[]
  ethicsApplications   EthicsApplication[]
  researchEvents       ResearchEvent[]
  expenses             ResearchExpense[]
  milestones           ResearchMilestone[]
  reports              ResearchReport[]

  @@index([projectCode])
  @@index([projectStatus])
  @@map("research_projects")
}

model Innovation {
  id                String           @id @default(uuid())
  title             String
  description       String?
  category          String?
  developmentStage  InnovationStage  @default(IDEA) @map("development_stage")
  status            InnovationStatus @default(SUBMITTED)
  researchProjectId String?          @map("research_project_id")
  submittedById     String           @map("submitted_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  researchProject ResearchProject? @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  submittedBy     Researcher       @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  events          ResearchEvent[]

  @@index([status])
  @@index([developmentStage])
  @@index([submittedById])
  @@index([researchProjectId])
  @@map("innovations")
}

model ProjectMember {
  id                String            @id @default(uuid())
  researchProjectId String            @map("research_project_id")
  researcherId      String            @map("researcher_id")
  role              ProjectMemberRole @default(RESEARCHER)
  isActive          Boolean           @default(true) @map("is_active")
  joinedAt          DateTime          @default(now()) @map("joined_at")
  leftAt            DateTime?         @map("left_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  researchProject    ResearchProject     @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  researcher         Researcher          @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  assignedActivities ProjectActivity[]
  assignedMilestones ResearchMilestone[]

  @@unique([researchProjectId, researcherId])
  @@index([researchProjectId])
  @@index([researcherId])
  @@index([role])
  @@index([isActive])
  @@map("project_members")
}

model ProjectActivity {
  id                String          @id @default(uuid())
  researchProjectId String          @map("research_project_id")
  assignedMemberId  String?         @map("assigned_member_id")
  title             String
  description       String?
  priority          RequestPriority @default(MEDIUM)
  status            ActivityStatus  @default(TODO)
  startDate         DateTime?       @map("start_date")
  dueDate           DateTime?       @map("due_date")
  completedAt       DateTime?       @map("completed_at")
  progress          Int             @default(0)
  notes             String?
  createdById       String          @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  assignedMember  ProjectMember?  @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([researchProjectId])
  @@index([assignedMemberId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("project_activities")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  title      String
  message    String
  type       NotificationType @default(INFO)
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  readAt     DateTime?        @map("read_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?     @map("user_id")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")
  description String?
  metadata    Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ResearchDocument {
  id                String         @id @default(uuid())
  researchProjectId String?        @map("research_project_id")
  uploadedById      String         @map("uploaded_by_id")
  title             String
  description       String?
  documentType      DocumentType   @map("document_type")
  fileName          String         @map("file_name")
  filePath          String         @map("file_path")
  storageKey        String         @unique @map("storage_key")
  mimeType          String         @map("mime_type")
  fileSize          Int            @map("file_size")
  checksum          String?
  version           Int            @default(1)
  status            DocumentStatus @default(DRAFT)
  archivedAt        DateTime?      @map("archived_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  researchProject ResearchProject?          @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  uploadedBy      User                      @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  versions        ResearchDocumentVersion[]
  receiptExpenses ResearchExpense[]

  @@index([researchProjectId])
  @@index([uploadedById])
  @@index([documentType])
  @@index([status])
  @@index([createdAt])
  @@map("research_documents")
}

model ResearchDocumentVersion {
  id                String   @id @default(uuid())
  documentId        String   @map("document_id")
  versionNumber     Int      @map("version_number")
  fileName          String   @map("file_name")
  filePath          String   @map("file_path")
  storageKey        String   @unique @map("storage_key")
  mimeType          String   @map("mime_type")
  fileSize          Int      @map("file_size")
  checksum          String?
  uploadedById      String   @map("uploaded_by_id")
  changeDescription String?  @map("change_description")
  createdAt         DateTime @default(now()) @map("created_at")

  document   ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
  @@map("research_document_versions")
}

model ResearchPublication {
  id                String            @id @default(uuid())
  researchProjectId String?           @map("research_project_id")
  title             String
  abstract          String?
  publicationType   PublicationType   @map("publication_type")
  journalName       String?           @map("journal_name")
  conferenceName    String?           @map("conference_name")
  publisher         String?
  doi               String?           @unique
  isbn              String?
  publicationDate   DateTime?         @map("publication_date")
  url               String?
  status            PublicationStatus @default(DRAFT)
  citationCount     Int?              @default(0) @map("citation_count")
  createdById       String            @map("created_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  researchProject ResearchProject?    @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("CreatedPublications", fields: [createdById], references: [id], onDelete: Restrict)
  authors         PublicationAuthor[]
  events          ResearchEvent[]

  @@index([researchProjectId])
  @@index([createdById])
  @@index([publicationType])
  @@index([status])
  @@index([doi])
  @@index([createdAt])
  @@map("research_publications")
}

model PublicationAuthor {
  id                    String   @id @default(uuid())
  publicationId         String   @map("publication_id")
  researcherId          String   @map("researcher_id")
  authorOrder           Int      @map("author_order")
  isCorrespondingAuthor Boolean  @default(false) @map("is_corresponding_author")
  createdAt             DateTime @default(now()) @map("created_at")

  publication ResearchPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  researcher  Researcher          @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([publicationId, researcherId])
  @@index([publicationId])
  @@index([researcherId])
  @@map("publication_authors")
}

model FundingOpportunity {
  id                  String                   @id @default(uuid())
  title               String
  organization        String
  description         String?
  fundingType         FundingType              @map("funding_type")
  minimumAmount       Decimal?                 @map("minimum_amount") @db.Decimal(14, 2)
  maximumAmount       Decimal?                 @map("maximum_amount") @db.Decimal(14, 2)
  applicationDeadline DateTime?                @map("application_deadline")
  eligibilityCriteria String?                  @map("eligibility_criteria")
  applicationUrl      String?                  @map("application_url")
  status              FundingOpportunityStatus @default(OPEN)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  applications GrantApplication[]

  @@index([status])
  @@index([fundingType])
  @@index([applicationDeadline])
  @@index([createdAt])
  @@map("funding_opportunities")
}

model GrantApplication {
  id                String                 @id @default(uuid())
  opportunityId     String                 @map("opportunity_id")
  researchProjectId String?                @map("research_project_id")
  applicantId       String                 @map("applicant_id")
  title             String
  requestedAmount   Decimal                @db.Decimal(14, 2)
  proposalSummary   String                 @map("proposal_summary")
  submittedAt       DateTime?              @map("submitted_at")
  reviewedAt        DateTime?              @map("reviewed_at")
  reviewedById      String?                @map("reviewed_by_id")
  reviewComment     String?                @map("review_comment")
  status            GrantApplicationStatus @default(DRAFT)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  opportunity     FundingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  researchProject ResearchProject?   @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  applicant       Researcher         @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  reviewedBy      User?              @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  grant           ResearchGrant?

  @@index([opportunityId])
  @@index([researchProjectId])
  @@index([applicantId])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
  @@map("grant_applications")
}

model ResearchGrant {
  id                      String      @id @default(uuid())
  grantNumber             String      @unique @map("grant_number")
  applicationId           String      @unique @map("application_id")
  researchProjectId       String?     @map("research_project_id")
  principalInvestigatorId String?     @map("principal_investigator_id")
  createdById             String      @map("created_by_id")
  awardedAmount           Decimal     @map("awarded_amount") @db.Decimal(14, 2)
  startDate               DateTime    @map("start_date")
  endDate                 DateTime    @map("end_date")
  spentAmount             Decimal     @default(0) @map("spent_amount") @db.Decimal(14, 2)
  status                  GrantStatus @default(ACTIVE)
  notes                   String?
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  application           GrantApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  researchProject       ResearchProject?   @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  principalInvestigator Researcher?        @relation("PrincipalInvestigator", fields: [principalInvestigatorId], references: [id], onDelete: SetNull)
  createdBy             User               @relation("CreatedGrants", fields: [createdById], references: [id], onDelete: Restrict)
  budgetAllocations     BudgetAllocation[]
  expenses              ResearchExpense[]

  @@index([grantNumber])
  @@index([applicationId])
  @@index([researchProjectId])
  @@index([principalInvestigatorId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("research_grants")
}

model EthicsApplication {
  id                 String                  @id @default(uuid())
  applicationCode    String                  @unique @map("application_code")
  researchProjectId  String                  @map("research_project_id")
  applicantId        String                  @map("applicant_id")
  title              String
  researchSummary    String                  @map("research_summary")
  methodology        String?
  participantDetails String?                 @map("participant_details")
  riskAssessment     String?                 @map("risk_assessment")
  benefitStatement   String?                 @map("benefit_statement")
  dataProtectionPlan String?                 @map("data_protection_plan")
  consentProcess     String?                 @map("consent_process")
  status             EthicsApplicationStatus @default(DRAFT)
  submittedAt        DateTime?               @map("submitted_at")
  reviewedAt         DateTime?               @map("reviewed_at")
  approvedAt         DateTime?               @map("approved_at")
  rejectedAt         DateTime?               @map("rejected_at")
  reviewerId         String?                 @map("reviewer_id")
  reviewComment      String?                 @map("review_comment")
  revisionComment    String?                 @map("revision_comment")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  researchProject ResearchProject  @relation(fields: [researchProjectId], references: [id], onDelete: Restrict)
  applicant       Researcher       @relation("EthicsApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewer        Researcher?      @relation("EthicsApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviews         EthicsReview[]
  reviewers       EthicsReviewer[]

  @@index([applicationCode])
  @@index([researchProjectId])
  @@index([applicantId])
  @@index([reviewerId])
  @@index([status])
  @@index([createdAt])
  @@map("ethics_applications")
}

model EthicsReview {
  id            String               @id @default(uuid())
  applicationId String               @map("application_id")
  reviewerId    String               @map("reviewer_id")
  decision      EthicsReviewDecision
  comment       String?
  reviewedAt    DateTime             @default(now()) @map("reviewed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  application EthicsApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Researcher        @relation("EthicsReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
  @@map("ethics_reviews")
}

model EthicsReviewer {
  id            String    @id @default(uuid())
  applicationId String    @map("application_id")
  reviewerId    String    @map("reviewer_id")
  assignedById  String    @map("assigned_by_id")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  isActive      Boolean   @default(true) @map("is_active")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  application EthicsApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Researcher        @relation("AssignedReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy  User              @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([applicationId, reviewerId])
  @@index([applicationId])
  @@index([reviewerId])
  @@index([assignedById])
  @@map("ethics_reviewers")
}

model ResearchEvent {
  id                   String      @id @default(uuid())
  eventCode            String      @unique @map("event_code")
  title                String
  description          String?
  eventType            EventType   @map("event_type")
  status               EventStatus @default(DRAFT)
  startDate            DateTime    @map("start_date")
  endDate              DateTime    @map("end_date")
  registrationDeadline DateTime?   @map("registration_deadline")
  venue                String?
  location             String?
  isVirtual            Boolean     @default(false) @map("is_virtual")
  meetingUrl           String?     @map("meeting_url")
  organizer            String?
  contactEmail         String?     @map("contact_email")
  contactPhone         String?     @map("contact_phone")
  maxParticipants      Int?        @map("max_participants")
  currentParticipants  Int         @default(0) @map("current_participants")
  researchProjectId    String?     @map("research_project_id")
  innovationId         String?     @map("innovation_id")
  publicationId        String?     @map("publication_id")
  objectives           String?
  eligibility          String?
  requirements         String?
  createdById          String      @map("created_by_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  researchProject ResearchProject?     @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  innovation      Innovation?          @relation(fields: [innovationId], references: [id], onDelete: SetNull)
  publication     ResearchPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Restrict)
  participations  EventParticipation[]

  @@index([eventCode])
  @@index([eventType])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([researchProjectId])
  @@index([innovationId])
  @@index([publicationId])
  @@index([createdById])
  @@index([createdAt])
  @@map("research_events")
}

model EventParticipation {
  id           String              @id @default(uuid())
  eventId      String              @map("event_id")
  researcherId String              @map("researcher_id")
  status       ParticipationStatus @default(REGISTERED)
  registeredAt DateTime            @default(now()) @map("registered_at")
  confirmedAt  DateTime?           @map("confirmed_at")
  attendedAt   DateTime?           @map("attended_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  event      ResearchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  researcher Researcher    @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@unique([eventId, researcherId])
  @@index([eventId])
  @@index([researcherId])
  @@index([status])
  @@index([registeredAt])
  @@map("event_participations")
}

model BudgetAllocation {
  id              String         @id @default(uuid())
  researchGrantId String         @map("research_grant_id")
  category        BudgetCategory
  allocatedAmount Decimal        @map("allocated_amount") @db.Decimal(14, 2)
  description     String?
  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  researchGrant ResearchGrant     @relation(fields: [researchGrantId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("CreatedAllocations", fields: [createdById], references: [id], onDelete: Restrict)
  expenses      ResearchExpense[]

  @@index([researchGrantId])
  @@index([category])
  @@index([createdById])
  @@map("budget_allocations")
}

model ResearchExpense {
  id                 String         @id @default(uuid())
  expenseCode        String         @unique @map("expense_code")
  researchGrantId    String         @map("research_grant_id")
  researchProjectId  String?        @map("research_project_id")
  budgetAllocationId String?        @map("budget_allocation_id")
  category           BudgetCategory
  description        String
  amount             Decimal        @db.Decimal(14, 2)
  expenseDate        DateTime       @map("expense_date")
  vendor             String?
  referenceNumber    String?        @map("reference_number")
  status             ExpenseStatus  @default(DRAFT)
  submittedById      String         @map("submitted_by_id")
  approvedById       String?        @map("approved_by_id")
  approvedAt         DateTime?      @map("approved_at")
  rejectionReason    String?        @map("rejection_reason")
  receiptDocumentId  String?        @map("receipt_document_id")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  researchGrant    ResearchGrant     @relation(fields: [researchGrantId], references: [id], onDelete: Restrict)
  researchProject  ResearchProject?  @relation(fields: [researchProjectId], references: [id], onDelete: SetNull)
  budgetAllocation BudgetAllocation? @relation(fields: [budgetAllocationId], references: [id], onDelete: SetNull)
  submittedBy      Researcher        @relation("SubmittedExpenses", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy       User?             @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  receiptDocument  ResearchDocument? @relation(fields: [receiptDocumentId], references: [id], onDelete: SetNull)

  @@index([researchGrantId])
  @@index([researchProjectId])
  @@index([budgetAllocationId])
  @@index([category])
  @@index([status])
  @@index([submittedById])
  @@index([approvedById])
  @@index([expenseDate])
  @@index([createdAt])
  @@map("research_expenses")
}

model ResearchMilestone {
  id                   String          @id @default(uuid())
  researchProjectId    String          @map("research_project_id")
  title                String
  description          String?
  milestoneOrder       Int             @default(0) @map("milestone_order")
  plannedStartDate     DateTime?       @map("planned_start_date")
  plannedDueDate       DateTime?       @map("planned_due_date")
  actualCompletionDate DateTime?       @map("actual_completion_date")
  status               MilestoneStatus @default(PLANNED)
  progress             Int             @default(0)
  responsibleMemberId  String?         @map("responsible_member_id")
  notes                String?
  createdById          String          @map("created_by_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  researchProject   ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  responsibleMember ProjectMember?  @relation(fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  createdBy         User            @relation("CreatedMilestones", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([researchProjectId])
  @@index([status])
  @@index([plannedDueDate])
  @@index([responsibleMemberId])
  @@index([createdById])
  @@index([milestoneOrder])
  @@map("research_milestones")
}

model ResearchReport {
  id                   String               @id @default(uuid())
  reportCode           String               @unique @map("report_code")
  title                String
  reportType           ResearchReportType   @map("report_type")
  researchProjectId    String               @map("research_project_id")
  submittedById        String               @map("submitted_by_id")
  reportingPeriodStart DateTime?            @map("reporting_period_start")
  reportingPeriodEnd   DateTime?            @map("reporting_period_end")
  submittedAt          DateTime?            @map("submitted_at")
  status               ResearchReportStatus @default(DRAFT)
  executiveSummary     String?              @map("executive_summary")
  objectives           String?
  methodology          String?
  achievements         String?
  challenges           String?
  findings             String?
  recommendations      String?
  conclusion           String?
  progressPercentage   Int?                 @map("progress_percentage")
  nextPeriodPlan       String?              @map("next_period_plan")
  reviewerId           String?              @map("reviewer_id")
  reviewComment        String?              @map("review_comment")
  reviewedAt           DateTime?            @map("reviewed_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  researchProject ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  submittedBy     Researcher      @relation("SubmittedReports", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewer        User?           @relation("ReviewedReports", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([reportCode])
  @@index([researchProjectId])
  @@index([submittedById])
  @@index([reviewerId])
  @@index([status])
  @@index([reportType])
  @@index([createdAt])
  @@map("research_reports")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([category])
  @@map("system_settings")
}
